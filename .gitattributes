* text=auto eol=lf
# Windows 批处理必须 CRLF：LF 只有的 .cmd 在括号 if 块和 goto 上会静默出错。
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.bin binary
*.zip binary
*.pdf binary
*.pptx binary
# Preserve the public FSCV source bytes and its recorded SHA-256 across platforms.
datasets/fscv_demo/raw/sources/* -text whitespace=cr-at-eol
